# Copy this file to .env and fill in your values. .env is git-ignored;
# this example file is safe to commit because it holds no real credentials.
# Find both keys at https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your-client-id
# Use the *Sandbox* secret. It is different from the client ID.
PLAID_SECRET=your-sandbox-secret
# Only "sandbox" is supported for now.
PLAID_ENV=sandbox

# --- MySQL (Aiven Cloud), see docs/phase5.md. Leave MYSQL_HOST empty to use in-memory storage.
# Copy these from the Aiven console: your MySQL service > Overview > Connection information.
MYSQL_HOST=your-service-name.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your-aiven-password
MYSQL_DATABASE=defaultdb
# A separate database for tests; every test run empties its tables.
MYSQL_TEST_DATABASE=finance_test
# Aiven's CA certificate (Overview > CA certificate > Download), saved here. certs/ is git-ignored.
MYSQL_SSL_CA=certs/aiven-ca.pem

# Key that encrypts Plaid access tokens in the database. Generate one with:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes stored tokens unreadable (you'd need to re-link with --relink).
PLAID_TOKEN_KEY=your-generated-key
